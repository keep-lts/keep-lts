{
  "name": "@keep-lts/extract-zip",
  "version": "2.0.2",
  "description": "Security-maintained drop-in fork of extract-zip. Patches CVE-2026-56876 and CVE-2026-19693 (symlink path traversal / arbitrary file write): symlinks may only point inside the target directory, and files are never written through a symlink. Original API unchanged.",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "extract-zip": "cli.js"
  },
  "scripts": {
    "ava": "ava",
    "coverage": "nyc ava",
    "lint": "yarn lint:js && yarn lint:ts && yarn tsd",
    "lint:js": "eslint .",
    "lint:ts": "eslint --config .eslintrc.typescript.js --ext .ts .",
    "test": "node --test test/security.test.js",
    "tsd": "tsd"
  },
  "files": [
    "cli.js",
    "index.d.ts",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "author": "max ogden",
  "license": "BSD-2-Clause",
  "repository": "keep-lts/extract-zip",
  "keywords": [
    "unzip",
    "zip",
    "extract",
    "cve-2026-56876",
    "cve-2026-19693",
    "security",
    "patch",
    "lts",
    "fork",
    "cwe-59-link-following-/-cwe-22-path-traversal"
  ],
  "engines": {
    "node": ">= 10.17.0"
  },
  "dependencies": {
    "debug": "^4.1.1",
    "get-stream": "^5.1.0",
    "yauzl": "^2.10.0"
  },
  "optionalDependencies": {
    "@types/yauzl": "^2.9.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^3.2.0",
    "@typescript-eslint/parser": "^3.2.0",
    "ava": "^3.5.1",
    "eslint": "^7.2.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-ava": "^10.2.0",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-node": "^11.0.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "fs-extra": "^9.0.0",
    "husky": "^4.2.3",
    "lint-staged": "^10.0.9",
    "nyc": "^15.0.0",
    "tsd": "^0.11.0",
    "typescript": "^3.8.3"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:ava/recommended",
      "plugin:import/errors",
      "plugin:import/warnings",
      "plugin:node/recommended",
      "plugin:promise/recommended",
      "standard"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "yarn lint:js --fix",
    "*.ts": "yarn lint:ts --fix"
  },
  "contributors": [
    "Keep LTS (security maintenance fork)"
  ],
  "bugs": {
    "url": "https://github.com/keep-lts/extract-zip/issues"
  },
  "homepage": "https://github.com/keep-lts/extract-zip",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
