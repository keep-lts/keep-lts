{
  "name": "@keep-lts/apidoc-core",
  "version": "0.15.1",
  "description": "Security-maintained drop-in fork of apidoc-core. Patches CVE-2025-13158 and CVE-2025-57317 (prototype pollution). Original API unchanged.",
  "author": "Peter Rottmann <rottmann@inveris.de>",
  "license": "MIT",
  "main": "./lib/index.js",
  "homepage": "https://github.com/keep-lts/apidoc-core",
  "repository": "keep-lts/apidoc-core",
  "bugs": {
    "url": "https://github.com/keep-lts/apidoc-core/issues"
  },
  "scripts": {
    "test": "node --test test/security.test.js",
    "jshint": "jshint lib/ test/"
  },
  "keywords": [
    "api",
    "apidoc",
    "doc",
    "documentation",
    "rest",
    "restful",
    "cve-2025-13158",
    "cve-2025-57317",
    "security",
    "patch",
    "lts",
    "fork",
    "cwe-1321-prototype-pollution"
  ],
  "engines": {
    "node": ">= 0.10.0"
  },
  "dependencies": {
    "fs-extra": "^9.0.1",
    "glob": "^7.1.6",
    "iconv-lite": "^0.6.2",
    "klaw-sync": "^6.0.0",
    "lodash": "^4.17.20",
    "semver": "~7.3.2"
  },
  "devDependencies": {
    "apidoc-example": "^0.2.3",
    "deep-equal": "^2.0.3",
    "jshint": "^2.12.0",
    "markdown-it": "^11.0.0",
    "mocha": "^8.1.1",
    "should": "~13.2.3"
  },
  "jshintConfig": {
    "camelcase": true,
    "curly": false,
    "eqeqeq": true,
    "forin": true,
    "latedef": false,
    "newcap": true,
    "undef": true,
    "unused": true,
    "trailing": true,
    "node": true,
    "browser": true,
    "predef": [
      "it",
      "describe",
      "before",
      "after"
    ]
  },
  "contributors": [
    "Keep LTS (security maintenance fork)"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
