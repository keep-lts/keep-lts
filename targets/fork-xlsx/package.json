{
  "name": "@keep-lts/xlsx",
  "version": "0.18.6",
  "author": "sheetjs",
  "description": "Security-maintained drop-in fork of xlsx. Back-ports SheetJS's fixes for CVE-2023-30533 (prototype pollution) and CVE-2024-22363 (ReDoS) onto the frozen npm 0.18.5 baseline. Original API unchanged.",
  "keywords": [
    "excel",
    "xls",
    "xlsx",
    "xlsb",
    "xlsm",
    "ods",
    "csv",
    "dbf",
    "dif",
    "sylk",
    "office",
    "spreadsheet",
    "cve-2023-30533",
    "cve-2024-22363",
    "security",
    "patch",
    "lts",
    "fork",
    "cwe-1321-prototype-pollution-/-cwe-1333-redos"
  ],
  "bin": {
    "xlsx": "./bin/xlsx.njs"
  },
  "main": "xlsx.js",
  "module": "xlsx.mjs",
  "unpkg": "dist/xlsx.full.min.js",
  "jsdelivr": "dist/xlsx.full.min.js",
  "types": "types/index.d.ts",
  "browser": {
    "buffer": false,
    "crypto": false,
    "stream": false,
    "process": false,
    "fs": false
  },
  "sideEffects": false,
  "dependencies": {
    "adler-32": "~1.3.0",
    "cfb": "~1.2.1",
    "codepage": "~1.15.0",
    "crc-32": "~1.2.1",
    "ssf": "~0.11.2",
    "wmf": "~1.0.1",
    "word": "~0.3.0"
  },
  "devDependencies": {
    "@sheetjs/uglify-js": "~2.7.3",
    "@types/node": "^8.5.9",
    "acorn": "7.4.1",
    "alex": "8.1.1",
    "blanket": "~1.2.3",
    "commander": "~2.17.1",
    "dtslint": "^0.1.2",
    "eslint": "7.23.0",
    "eslint-plugin-html": "^6.1.2",
    "eslint-plugin-json": "^2.1.2",
    "exit-on-epipe": "~1.0.1",
    "fflate": "^0.7.1",
    "jsdom": "~11.1.0",
    "markdown-spellcheck": "^1.3.1",
    "mocha": "~2.5.3",
    "sinon": "^1.17.7",
    "typescript": "2.2.0"
  },
  "repository": "keep-lts/xlsx",
  "scripts": {
    "test": "node --test test/security.test.js"
  },
  "config": {
    "blanket": {
      "pattern": "xlsx.js"
    }
  },
  "alex": {
    "allow": [
      "chinese",
      "special",
      "simple",
      "just",
      "crash",
      "wtf",
      "holes"
    ]
  },
  "homepage": "https://github.com/keep-lts/xlsx",
  "bugs": {
    "url": "https://github.com/keep-lts/xlsx/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=0.8"
  },
  "contributors": [
    "Keep LTS (security maintenance fork)"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
